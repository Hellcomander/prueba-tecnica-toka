// auth_db: dueño de las credenciales (email + hash argon2id) y de las sesiones de refresh.
// Los IDs (UUID) los genera el dominio, no la base: el id de la cuenta es el userId de todo el
// sistema. El perfil del usuario (nombre, puesto) vive en user-service, no aquí.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Credencial. `status` lo refleja user-service vía `user.status_changed`; `status_version`
/// descarta eventos desordenados y `version` es el bloqueo optimista de la fila.
model Account {
  id            String    @id @db.Uuid
  email         String    @unique @db.VarChar(254)
  /// Hash argon2id (incluye sal y parámetros). Nunca sale del servicio.
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  status        String    @default("ACTIVE") @db.VarChar(16)
  statusVersion Int       @default(0) @map("status_version")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]

  @@map("accounts")
}

/// Sesión = familia de refresh tokens. Revocarla mata a toda la familia de una vez, que es la
/// reacción al detectar reúso de un refresh ya rotado.
model Session {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Tope absoluto: renovar no vuelve eterna la sesión.
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?        @map("revoked_reason") @db.VarChar(32)
  account       Account        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens        RefreshToken[]

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Del refresh token solo se guarda su SHA-256: quien lea la base no puede renovar sesiones.
/// `used_at` convierte la rotación en un hecho verificable: un token con used_at que vuelve a
/// presentarse es reúso, y dispara la revocación de la sesión entera.
model RefreshToken {
  tokenHash String    @id @map("token_hash") @db.Char(64)
  sessionId String    @map("session_id") @db.Uuid
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Idempotencia de consumidores: el insert va en la misma transacción que el efecto.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  type        String   @db.VarChar(64)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("processed_events")
}
