# Copia este archivo a .env SOLO si quieres cambiar algo. Sin .env, el stack corre completo
# en modo mock (IA determinista, sin llamadas externas) con credenciales de desarrollo local.
# .env está en .gitignore: nunca se commitea.
#
# Contraseñas: usa solo caracteres seguros para URL (letras, números, - y _), porque los
# servicios las usan dentro de DATABASE_URL. Los scripts de init de Postgres/Mongo y el usuario
# de RabbitMQ solo se aplican con volúmenes vacíos: si cambias una contraseña después,
# recrea los volúmenes con `docker compose down -v`.

# --- Gateway ---------------------------------------------------------------
GATEWAY_PORT=8080
# real: la SPA habla con el backend por el gateway (default, y lo que se demuestra).
# mock: resuelve el login en el navegador con los usuarios semilla, para ver la UI sin stack.
VITE_API_MODE=real

# --- PostgreSQL (un contenedor, una base y un usuario dueño por servicio) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pw
AUTH_DB_PASSWORD=auth_dev_pw
USER_DB_PASSWORD=user_dev_pw
ROLE_DB_PASSWORD=role_dev_pw

# --- MongoDB (auditoría) ---------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev_pw
MONGO_AUDIT_PASSWORD=audit_dev_pw

# --- Redis / RabbitMQ ------------------------------------------------------
REDIS_PASSWORD=redis_dev_pw
RABBITMQ_USER=toka
RABBITMQ_PASSWORD=rabbit_dev_pw

# --- Usuarios de demostración ----------------------------------------------
# Datos sintéticos para poder entrar a la UI recién clonado el repo. SEED_DEMO_DATA=false
# arranca el stack sin ellos (solo quedan los roles de sistema, que sí son obligatorios).
# En un despliegue real estas cuentas no existirían: se crean desde /api/v1/accounts.
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=Admin123!demo
SEED_AUDITOR_PASSWORD=Auditor123!demo
SEED_VIEWER_PASSWORD=Viewer123!demo
# Cookie de refresh: en local va por http, así que Secure se apaga. En producción, true.
COOKIE_SECURE=false

# --- Agente de IA (Parte 2) --------------------------------------------------
# AI_PROVIDER=auto: Gemini si hay GEMINI_API_KEY, si no el proveedor mock determinista.
# AI_PROVIDER=mock fuerza el mock aunque haya key (tests, evaluación reproducible).
# Free tier: Google puede usar los prompts para mejorar sus modelos; usa solo datos sintéticos.
AI_PROVIDER=auto
GEMINI_API_KEY=
# Modelos validados en el spike de F0 (docs/spikes.md). Son configuración, no constantes en código.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
AI_LLM_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
# Límites propios, por debajo de la cuota del proyecto (ver AI Studio > Rate limits).
AI_GLOBAL_RPM=8
AI_GLOBAL_RPD=200
AI_USER_RPM=4
AI_USER_DAILY_TOKENS=50000
# Versión del prompt del sistema: agent-v1 (zero-shot) o agent-v2 (+ 4 ejemplos few-shot).
# Se compara una contra otra con el golden set; no se decide de memoria.
AI_PROMPT_VERSION=agent-v2
# Frase de control que nunca debe aparecer en una respuesta: si sale, el modelo está repitiendo
# su prompt y la respuesta se descarta entera. Cámbiala en cada despliegue real.
AI_CANARY=TOKA-CANARY-7F3A91
# Tope del bucle de herramientas. Sin él, un modelo que insiste convierte una pregunta en una
# factura abierta y en una petición HTTP que no termina.
AI_MAX_TOOL_STEPS=4
AI_RETRIEVAL_LIMIT=5
AI_RETRIEVAL_MIN_SCORE=0.35
AI_CACHE_TTL_SECONDS=300
# Precios (USD por millón de tokens) para estimar el costo. Son configuración porque cambian sin
# avisar: un número de costo que envejece en silencio es peor que no tenerlo.
AI_PRICE_INPUT_PER_MTOK=0.3
AI_PRICE_OUTPUT_PER_MTOK=2.5
AI_PRICE_EMBEDDING_PER_MTOK=0.15
# Store vectorial de la base de conocimiento.
QDRANT_COLLECTION=toka_kb
